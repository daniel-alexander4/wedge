      "types": "./express.d.ts",
      "default": "./lib/express.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "express.d.ts",
    "lib/",
    "static/"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
