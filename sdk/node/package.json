{
  "name": "wedge-rp",
  "version": "0.1.0",
  "description": "Relying-party middleware for wedge: let users sign in to your site with their SSH key",
  "license": "MIT",
  "author": "Daniel Alexander",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
