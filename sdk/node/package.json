    "express": "^5.0.0"
  },
  "keywords": [
    "wedge",
    "ssh",
    "sshsig",
    "authentication",
    "login",
    "passwordless",
    "express"
  ],
  "homepage": "https://github.com/daniel-alexander4/wedge",
  "repository": {
    "type": "git",
