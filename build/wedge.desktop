[Desktop Entry]
Type=Application
Name=wedge
Comment=SSH-key web authentication; launches your sites and SSH hosts
Exec=wedge %u
Icon=wedge
Terminal=false
# No registered main category on purpose (X- prefix keeps the validator
# happy): menus file wedge under their catch-all "Other" group.
Categories=X-Other;
MimeType=x-scheme-handler/wedge;
StartupNotify=true
# Matches `chromium --class=Wedge` (set in internal/browser) so the panel uses
# this entry's themed Icon=wedge instead of upscaling the page favicon.
StartupWMClass=Wedge
